# Where `taxonomy-pipeline serve` is running.
TAXONOMY_API_URL=http://localhost:8000
# The token of the pipeline API at TAXONOMY_API_URL (the same value as that
# API's TAXONOMY_API_TOKEN in backend/.env). The proxy adds it server-side; it is
# never sent to the browser.
# Replace change-me with the API's real token; the API refuses the placeholder.
TAXONOMY_API_TOKEN=change-me
# Let the dashboard start pipeline runs (POST /runs). Anyone who can open the
# dashboard acts with the token above, so enable this only in a trusted
# environment.
PIPELINE_ALLOW_RUN_CREATION=false
