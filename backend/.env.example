MYSQL_DATABASE=greygigz_beta
MYSQL_USER=senseigigs
MYSQL_PASSWORD=localpassword
MYSQL_ROOT_PASSWORD=localrootpassword
MYSQL_PORT=3307
ADMINER_PORT=8080

# OpenAI (copy this file to .env and replace the placeholders)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Taxonomy pipeline API (`taxonomy-pipeline serve`). Every request must send
# `Authorization: Bearer <TAXONOMY_API_TOKEN>`; with no token set, every request
# is refused. Use a long random value, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`,
# and give the dashboard the same value in frontend/.env.local. Each person running
# their own API picks their own; share one only for a server several people use.
# Replace change-me: the API treats it as no token and refuses every request.
TAXONOMY_API_TOKEN=change-me
# Local development only: skip the token check entirely.
# TAXONOMY_API_AUTH=off
# Directories POST /runs may read dataset files from (default: backend/).
# TAXONOMY_DATA_ROOTS=

# Let dashboard rounds use LLM steps (the saturation judge and Case B), which spend OpenAI
# credits. The dashboard has no login, so only turn this on where it runs on localhost.
# TAXONOMY_ALLOW_LLM=true
